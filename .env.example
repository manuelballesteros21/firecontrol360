POSTGRES_DB=firecontrol360
POSTGRES_USER=firecontrol
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://firecontrol:change-this-local-password@localhost:5432/firecontrol360
# Server-only connection for platform provisioning/invitation acceptance. Never expose to clients.
PROVISIONING_DATABASE_URL=postgresql://firecontrol_provisioner:replace-me@localhost:5432/firecontrol360
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
MINIO_ROOT_USER=firecontroladmin
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=firecontrol360
S3_ACCESS_KEY_ID=firecontroladmin
S3_SECRET_ACCESS_KEY=change-this-minio-password
S3_FORCE_PATH_STYLE=true
# Bootstrap only; supply securely in the terminal, never commit real values.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_NAME=
# PLATFORM_ADMIN_PASSWORD=

# Outbox encryption: generate with: openssl rand -base64 32
OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
# SMTP settings for invitation delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=FireControl 360 <no-reply@example.com>
