POSTGRES_DB=firecontrol360
POSTGRES_USER=firecontrol
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://firecontrol:change-this-local-password@localhost:5432/firecontrol360
# Separate, tightly controlled database role for platform provisioning and invitation acceptance.
PROVISIONING_DATABASE_URL=postgresql://firecontrol_provisioner:replace-me@localhost:5432/firecontrol360
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=firecontrol360
S3_ACCESS_KEY_ID=firecontroladmin
S3_SECRET_ACCESS_KEY=change-this-minio-password
S3_FORCE_PATH_STYLE=true
